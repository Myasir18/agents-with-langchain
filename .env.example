# Copy this file to .env and fill in the blanks. Never commit .env.
# The instructor supplies GROQ_MODEL_NAME.
# Put your real GROQ_API_KEY only in your untracked .env, never in this file.
# GROQ_API_BASE_URL is the Groq host only. Do not add /openai/v1 to it.
APP_ENV=development
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com
GROQ_MODEL_NAME=
HOST=127.0.0.1
PORT=8000
